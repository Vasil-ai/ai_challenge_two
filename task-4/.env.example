# Sample environment configuration for the ATC MCP server.
# Copy to .env and adjust as needed; or export the variables in your shell.

# Network --------------------------------------------------------------------
ATC_SERVER_PORT=8080
ATC_SSE_MESSAGE_ENDPOINT=/mcp/messages

# Runways: comma-separated list of `id:lengthMeters`. ID must be unique.
ATC_RUNWAYS=R1:3500,R2:2500,R3:4000

# Static airport capacities --------------------------------------------------
ATC_GATE_COUNT=6
ATC_GROUND_CREW_COUNT=8

# Runway separation buffers (seconds) ----------------------------------------
ATC_SEPARATION_TAKEOFF_SECONDS=120
ATC_SEPARATION_LANDING_SECONDS=180
ATC_SEPARATION_MIXED_SECONDS=240

# Other timing parameters (seconds) ------------------------------------------
ATC_GATE_TURNAROUND_SECONDS=1800
ATC_DEPENDENCY_BUFFER_SECONDS=900
ATC_SCHEDULING_HORIZON_SECONDS=43200
ATC_OPERATION_DURATION_ARRIVAL_SECONDS=600
ATC_OPERATION_DURATION_DEPARTURE_SECONDS=480

# Deterministic schedule origin (ISO-8601 instant) ---------------------------
ATC_EPOCH=2026-01-01T00:00:00Z
